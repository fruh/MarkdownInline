%YAML 1.2
---
# Optional, removable module: HTML-like tags that look like their Markdown twins.
#   <code>..</code> `..`     <bold>..</bold> **..**     <codeblock>..</codeblock> ``` block
#   <request>/<response> tinted raw blocks, <highlight>..</highlight> inside raw blocks
#   <list>..</list> and <olist>..</olist> (plain lines are items; the bullet or number
#   is drawn by html_tags.py).
# Reuses the Markdown scopes so the color scheme needs nothing extra. To remove the
# feature delete this file and html_tags.py (see README, "HTML-like tags").
name: Markdown Inline HTML
version: 2
scope: text.html.markdown.inline.html
extends: Packages/MarkdownInline/Markdown Inline.sublime-syntax
hidden: true

contexts:
  # the stock main only hands over to 'markdown', where the block rules live; prepend
  # there so these win over its raw html-blocks rule.
  markdown:
    - meta_prepend: true
    - match: '(?i)^\s*(<codeblock>)\s*$'
      scope: markup.raw.block.markdown
      captures:
        1: punctuation.definition.metadata.begin.markdown
      push: html-codeblock
    - match: '(?i)^\s*(<request>)\s*$'
      scope: markup.raw.block.markdown meta.block.request.markdown
      captures:
        1: punctuation.definition.metadata.begin.markdown
      push: html-request
    - match: '(?i)^\s*(<response>)\s*$'
      scope: markup.raw.block.markdown meta.block.response.markdown
      captures:
        1: punctuation.definition.metadata.begin.markdown
      push: html-response
    - match: '(?i)^\s*(<list>)\s*$'
      scope: markup.list.html-unordered.markdown
      captures:
        1: punctuation.definition.metadata.begin.markdown
      push: html-list
    - match: '(?i)^\s*(<olist>)\s*$'
      scope: markup.list.html-ordered.markdown
      captures:
        1: punctuation.definition.metadata.begin.markdown
      push: html-olist

  html-codeblock:
    - meta_include_prototype: false
    - meta_content_scope: markup.raw.block.markdown
    - match: '(?i)^\s*(</codeblock>)'
      scope: markup.raw.block.markdown
      captures:
        1: punctuation.definition.metadata.end.markdown
      pop: true
    - include: html-highlight
    - include: highlight-markers
    - include: highlight-open

  html-request:
    - meta_include_prototype: false
    - meta_content_scope: markup.raw.block.markdown meta.block.request.markdown
    - match: '(?i)^\s*(</request>)'
      scope: markup.raw.block.markdown meta.block.request.markdown
      captures:
        1: punctuation.definition.metadata.end.markdown
      pop: true
    - include: html-highlight
    - include: highlight-markers
    - include: highlight-open

  html-response:
    - meta_include_prototype: false
    - meta_content_scope: markup.raw.block.markdown meta.block.response.markdown
    - match: '(?i)^\s*(</response>)'
      scope: markup.raw.block.markdown meta.block.response.markdown
      captures:
        1: punctuation.definition.metadata.end.markdown
      pop: true
    - include: html-highlight
    - include: highlight-markers
    - include: highlight-open

  # only included by the raw blocks above, so <highlight> is literal text elsewhere
  html-highlight:
    - match: '(?i)(<highlight>)(.*?)(</highlight>)'
      captures:
        1: punctuation.definition.metadata.begin.markdown meta.highlight-marker.html.markdown
        2: markup.highlight.html.markdown
        3: punctuation.definition.metadata.end.markdown meta.highlight-marker.html.markdown

  # a highlight whose close is not on the same line: it runs over several lines but stops
  # at the end of the raw block, so an unclosed one cannot leak. The single-line rules
  # (html-highlight, highlight-markers) come first and win when the close is on the line.
  highlight-open:
    - match: '(?i)<highlight>'
      scope: punctuation.definition.metadata.begin.markdown meta.highlight-marker.html.markdown
      push: hl-open-html
    - match: '(?i)@@HL\(red\)@@'
      scope: punctuation.definition.metadata.begin.markdown meta.highlight-marker.html.markdown
      push: hl-open-red
    - match: '(?i)@@HL\(yellow\)@@'
      scope: punctuation.definition.metadata.begin.markdown meta.highlight-marker.html.markdown
      push: hl-open-yellow
    - match: '(?i)@@HL\(blue\)@@'
      scope: punctuation.definition.metadata.begin.markdown meta.highlight-marker.html.markdown
      push: hl-open-blue
    - match: '(?i)@@HL\(green\)@@'
      scope: punctuation.definition.metadata.begin.markdown meta.highlight-marker.html.markdown
      push: hl-open-green
    - match: '(?i)@@HL(?:\([^)]*\))?@@'
      scope: punctuation.definition.metadata.begin.markdown meta.highlight-marker.html.markdown
      push: hl-open-default

  hl-open-html:
    - meta_include_prototype: false
    - match: '(?i)^(?=\s*</(?:codeblock|request|response)>)'
      pop: true
    - match: '(?i)</highlight>'
      scope: punctuation.definition.metadata.end.markdown meta.highlight-marker.html.markdown
      pop: true
    - match: '(?:(?!(?i:</highlight>)).)+'
      scope: markup.highlight.html.markdown

  hl-open-red:
    - meta_include_prototype: false
    - match: '(?i)^(?=\s*</(?:codeblock|request|response)>)'
      pop: true
    - match: '(?i)@@ENDHL@@'
      scope: punctuation.definition.metadata.end.markdown meta.highlight-marker.html.markdown
      pop: true
    - match: '(?:(?!(?i:@@ENDHL@@)).)+'
      scope: markup.highlight.red.markdown

  hl-open-yellow:
    - meta_include_prototype: false
    - match: '(?i)^(?=\s*</(?:codeblock|request|response)>)'
      pop: true
    - match: '(?i)@@ENDHL@@'
      scope: punctuation.definition.metadata.end.markdown meta.highlight-marker.html.markdown
      pop: true
    - match: '(?:(?!(?i:@@ENDHL@@)).)+'
      scope: markup.highlight.yellow.markdown

  hl-open-blue:
    - meta_include_prototype: false
    - match: '(?i)^(?=\s*</(?:codeblock|request|response)>)'
      pop: true
    - match: '(?i)@@ENDHL@@'
      scope: punctuation.definition.metadata.end.markdown meta.highlight-marker.html.markdown
      pop: true
    - match: '(?:(?!(?i:@@ENDHL@@)).)+'
      scope: markup.highlight.blue.markdown

  hl-open-green:
    - meta_include_prototype: false
    - match: '(?i)^(?=\s*</(?:codeblock|request|response)>)'
      pop: true
    - match: '(?i)@@ENDHL@@'
      scope: punctuation.definition.metadata.end.markdown meta.highlight-marker.html.markdown
      pop: true
    - match: '(?:(?!(?i:@@ENDHL@@)).)+'
      scope: markup.highlight.green.markdown

  hl-open-default:
    - meta_include_prototype: false
    - match: '(?i)^(?=\s*</(?:codeblock|request|response)>)'
      pop: true
    - match: '(?i)@@ENDHL@@'
      scope: punctuation.definition.metadata.end.markdown meta.highlight-marker.html.markdown
      pop: true
    - match: '(?:(?!(?i:@@ENDHL@@)).)+'
      scope: markup.highlight.markdown

  html-list:
    - meta_content_scope: markup.list.html-unordered.markdown
    - match: '(?i)(</list>)'
      scope: markup.list.html-unordered.markdown
      captures:
        1: punctuation.definition.metadata.end.markdown
      pop: true
    - include: inlines

  html-olist:
    - meta_content_scope: markup.list.html-ordered.markdown
    - match: '(?i)(</olist>)'
      scope: markup.list.html-ordered.markdown
      captures:
        1: punctuation.definition.metadata.end.markdown
      pop: true
    - include: inlines

  markups:
    - meta_prepend: true
    - match: '(?i)(<code>)(.*?)(</code>)'
      scope: markup.raw.inline.markdown
      captures:
        1: punctuation.definition.raw.begin.markdown
        3: punctuation.definition.raw.end.markdown
    - match: '(?i)(<bold>)(.*?)(</bold>)'
      scope: markup.bold.markdown
      captures:
        1: punctuation.definition.bold.begin.markdown
        3: punctuation.definition.bold.end.markdown
