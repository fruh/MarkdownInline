{
    // Enable the inline preview automatically for Markdown views.
    "auto_enable": true,
    // Apply the bundled "Markdown Inline" color scheme when toggled on.
    "apply_color_scheme": true,
    // Use the bundled Markdown overlay syntax (colors the table continuation marker).
    "apply_syntax": true,
    // Delay before re-rendering after an edit.
    "debounce_ms": 150,
    // Skip rendering for files longer than this many lines.
    "max_lines": 20000,
    // Pixel width images are scaled to.
    "image_max_width": 600,
    // Show a rendered copy of tables below the raw source (no folding).
    "render_tables": false,
    // Size of todo-list checkboxes relative to the line height (1.0 is about half a line); 1.6 is the default.
    "checkbox_scale": 1.6,
    // Mark drawn inside a checked checkbox: "check" or "cross".
    "checkbox_mark": "check",
    // Pixels the checkbox hangs below the text baseline; raise it to move the box down.
    "checkbox_offset_px": 0,
    // Underline all headings (H1-H6) in their heading color.
    "underline_headings": true,
    // Underline the tags #todo, #done, #vulnerable, #reported and #falsepositive in
    // their color. The tag text is always colored by the scheme (tag_* variables).
    "highlight_tags": true,
    // Fold the URL of inline links to "..." (shown again while the cursor is on the
    // line). Links in tables and image sources are left alone.
    "fold_links": true,
    // Thin rule under H1/H2 lines (hidden while the cursor is on the line).
    "heading_rules": true,
    // Align a table's columns automatically when the cursor leaves it, but only if it was edited.
    "align_tables_on_leave": true,
    // When saving, align the tables modified since the file was loaded or last saved.
    "align_tables_on_save": true,
    // Room reserved when wrapping tables so lines don't soft-wrap; raise it if they still do.
    "table_gap_chars": 12,
    // Horizontal margin, in pixels, left free when sizing rendered tables.
    "table_margin_px": 40,
    // Plain paste (Cmd+V / Ctrl+V) in Markdown files pastes a clipboard image when
    // the clipboard holds no text. Text pastes are never changed.
    "paste_image_on_paste": true,
    // Directory (relative to the Markdown file) where pasted images are saved.
    "image_dir": "images",
    // Filename prefix for pasted images.
    "image_name_prefix": "pasted_",
    // strftime format used for the pasted image filename.
    "image_name_format": "%Y%m%d_%H%M%S",
    // Optional shell command that writes image bytes to stdout, overriding
    // auto-detection of the clipboard tool (e.g. "/opt/homebrew/bin/pngpaste -").
    "paste_image_command": ""
}
