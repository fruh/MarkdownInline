%YAML 1.2
---
# Overlay on the stock Markdown syntax: gives the table continuation marker and the
# status tags (#todo, #done, ...) their own scopes so the color scheme can color them.
name: Markdown Inline
version: 2
scope: text.html.markdown.inline
extends: Packages/Markdown/Markdown.sublime-syntax
hidden: true

contexts:
  table-cell-content:
    - meta_prepend: true
    - match: '↳'
      scope: punctuation.definition.continuation.table.markdown

  # included by paragraphs, lists, block quotes, headings, emphasis and table cells.
  # the # must start the word, so '# Heading' and URL anchors do not match.
  markups:
    - meta_prepend: true
    - include: highlight-markers
    - match: '(?i)(?<![^\s(])#todo(?![\w-])'
      scope: markup.tag.todo.markdown
    - match: '(?i)(?<![^\s(])#done(?![\w-])'
      scope: markup.tag.done.markdown
    - match: '(?i)(?<![^\s(])#vulnerable(?![\w-])'
      scope: markup.tag.vulnerable.markdown
    - match: '(?i)(?<![^\s(])#reported(?![\w-])'
      scope: markup.tag.reported.markdown
    - match: '(?i)(?<![^\s(])#falsepositive(?![\w-])'
      scope: markup.tag.falsepositive.markdown

  # @@HL(red)@@text@@ENDHL@@ on one line; red, yellow, blue and green, yellow by default
  highlight-markers:
    - match: '(?i)(@@HL\(red\)@@)(.*?)(@@ENDHL@@)'
      captures:
        1: punctuation.definition.metadata.begin.markdown meta.highlight-marker.markdown
        2: markup.highlight.red.markdown
        3: punctuation.definition.metadata.end.markdown meta.highlight-marker.markdown
    - match: '(?i)(@@HL\(yellow\)@@)(.*?)(@@ENDHL@@)'
      captures:
        1: punctuation.definition.metadata.begin.markdown meta.highlight-marker.markdown
        2: markup.highlight.yellow.markdown
        3: punctuation.definition.metadata.end.markdown meta.highlight-marker.markdown
    - match: '(?i)(@@HL\(blue\)@@)(.*?)(@@ENDHL@@)'
      captures:
        1: punctuation.definition.metadata.begin.markdown meta.highlight-marker.markdown
        2: markup.highlight.blue.markdown
        3: punctuation.definition.metadata.end.markdown meta.highlight-marker.markdown
    - match: '(?i)(@@HL\(green\)@@)(.*?)(@@ENDHL@@)'
      captures:
        1: punctuation.definition.metadata.begin.markdown meta.highlight-marker.markdown
        2: markup.highlight.green.markdown
        3: punctuation.definition.metadata.end.markdown meta.highlight-marker.markdown
    # no color, an empty one or an unknown name: the default (yellow)
    - match: '(?i)(@@HL(?:\([^)]*\))?@@)(.*?)(@@ENDHL@@)'
      captures:
        1: punctuation.definition.metadata.begin.markdown meta.highlight-marker.markdown
        2: markup.highlight.markdown
        3: punctuation.definition.metadata.end.markdown meta.highlight-marker.markdown
